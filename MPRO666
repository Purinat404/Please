-- Aim Lock
local function getTgt()
    local cl=nil
    local sh=cfg.aimRange
    local mc=LP.Character
    local mh=getHRP(mc)
    if not mh then return nil end
    local cl2=Cam.CFrame.LookVector
    for _,p in ipairs(Players:GetPlayers()) do
        if p==LP then continue end
        local c=p.Character
        local hum=getHum(c)
        local tp=c and (c:FindFirstChild(cfg.aimPart) or getHRP(c))
        if tp and hum and (hum.Health or 1)>0 then
            local d=(mh.Position-tp.Position).Magnitude
            if d<sh then
                local dir=(tp.Position-Cam.CFrame.Position).Unit
                local dot=cl2:Dot(dir)
                local ang=math.deg(math.acos(math.clamp(dot,-1,1)))
                if ang<=cfg.aimFOV/2 then
                    sh=d
                    cl=tp
                end
            end
        end
    end
    return cl
end

local function aimLock()
    if not cfg.aim then return end
    local t=getTgt()
    if not t then return end
    local mc=LP.Character
    local mh=getHRP(mc)
    if not mh then return end
    local mp=Cam.CFrame.Position
    local dir=(t.Position-mp).Unit
    local tCF=CFrame.new(mp,mp+dir)
    local sm=math.clamp(cfg.aimSmooth,0.01,1)
    Cam.CFrame=Cam.CFrame:Lerp(tCF,sm)
end

