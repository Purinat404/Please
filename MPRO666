-- Slider
local function mkSli(txt,mn,mx,def,tab,cb)
    local r=Instance.new("Frame")
    r.Size=UDim2.new(1,-8,0,54)
    r.BackgroundColor3=C.panel
    r.BorderSizePixel=0
    r:SetAttribute("Tab",tab)
    r.Parent=sc
    local rc=Instance.new("UICorner")
    rc.CornerRadius=UDim.new(0,8)
    rc.Parent=r
    local lb=Instance.new("TextLabel")
    lb.Size=UDim2.new(1,-20,0,20)
    lb.Position=UDim2.new(0,12,0,6)
    lb.BackgroundTransparency=1
    lb.Text=txt..": "..def
    lb.TextColor3=C.text
    lb.TextSize=12
    lb.Font=Enum.Font.Code
    lb.TextXAlignment=Enum.TextXAlignment.Left
    lb.Parent=r
    local br=Instance.new("Frame")
    br.Size=UDim2.new(1,-24,0,6)
    br.Position=UDim2.new(0,12,0,36)
    br.BackgroundColor3=Color3.fromRGB(40,25,55)
    br.BorderSizePixel=0
    br.Parent=r
    local bc2=Instance.new("UICorner")
    bc2.CornerRadius=UDim.new(1,0)
    bc2.Parent=br
    local fl=Instance.new("Frame")
    fl.Size=UDim2.new((def-mn)/(mx-mn),0,1,0)
    fl.BackgroundColor3=C.accent2
    fl.BorderSizePixel=0
    fl.Parent=br
    local fc=Instance.new("UICorner")
    fc.CornerRadius=UDim.new(1,0)
    fc.Parent=fl
    local dr=false
    local function up(x)
        local rl=math.clamp((x-br.AbsolutePosition.X)/br.AbsoluteSize.X,0,1)
        local v=math.floor(mn+(mx-mn)*rl)
        fl.Size=UDim2.new(rl,0,1,0)
        lb.Text=txt..": "..v
        if cb then pcall(cb,v) end
    end
    br.InputBegan:Connect(function(i)
        if i.UserInputType==Enum.UserInputType.MouseButton1 or i.UserInputType==Enum.UserInputType.Touch then
            dr=true
            up(i.Position.X)
        end
    end)
    br.InputEnded:Connect(function(i)
        if i.UserInputType==Enum.UserInputType.MouseButton1 or i.UserInputType==Enum.UserInputType.Touch then
            dr=false
        end
    end)
    UIS.InputChanged:Connect(function(i)
        if dr and (i.UserInputType==Enum.UserInputType.MouseMovement or i.UserInputType==Enum.UserInputType.Touch) then
            up(i.Position.X)
        end
    end)
end

