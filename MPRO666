-- อัปเดต ESP
local function updateESP()
    hue=(hue+0.008)%1
    if not cfg.esp then
        local t={}
        for k,v in pairs(espCache) do
            if typeof(v)=="Instance" then
                table.insert(t,k)
            end
        end
        for _,k in ipairs(t) do
            local uid=tonumber(string.match(k,"%d+"))
            if uid then
                for _,p in ipairs(Players:GetPlayers()) do
                    if p.UserId==uid then
                        clearESP(p)
                        break
                    end
                end
            end
        end
        return
    end
    for _,plr in ipairs(Players:GetPlayers()) do
        if plr==LP then continue end
        local char=plr.Character
        if not char then continue end
        local hrp=getHRP(char)
        local hum=getHum(char)
        if hrp and hum then
            local uid=plr.UserId
            if not espCache[uid] then
                createESP(plr)
                task.wait(0.03)
            end
            local bb=espCache[uid]
            if bb and bb.Parent then
                bb.Adornee=hrp
                local di=(Cam.CFrame.Position-hrp.Position).Magnitude
                bb.Enabled=di<=cfg.maxDist
                local s=math.clamp(500/math.max(di,1),0.3,2)
                bb.Size=UDim2.new(0,80*s,0,120*s)
                local rc=C.accent
                if cfg.rainbow then
                    rc=Color3.fromHSV(hue,0.8,1)
                end
                if espCache[uid.."_bs"] then
                    espCache[uid.."_bs"].Color=rc
                end
                if espCache[uid.."_n"] then
                    espCache[uid.."_n"].Visible=cfg.name
                    espCache[uid.."_n"].TextColor3=rc
                end
                if espCache[uid.."_d"] then
                    espCache[uid.."_d"].Visible=cfg.dist
                    espCache[uid.."_d"].Text=math.floor(di).." studs"
                end
                if espCache[uid.."_hb"] and espCache[uid.."_hf"] then
                    espCache[uid.."_hb"].Visible=cfg.hp
                    local maxH=hum.MaxHealth or 100
                    local curH=hum.Health or 100
                    local pc=curH/math.max(maxH,1)
                    espCache[uid.."_hf"].Size=UDim2.new(math.clamp(pc,0,1),0,1,0)
                    espCache[uid.."_hf"].BackgroundColor3=pc>0.6 and Color3.fromRGB(0,255,100) or pc>0.3 and Color3.fromRGB(255,200,0) or Color3.fromRGB(255,50,50)
                end
                if espCache[uid.."_hl"] then
                    espCache[uid.."_hl"].Adornee=(cfg.aura and di<=cfg.maxDist) and char or nil
                    espCache[uid.."_hl"].FillColor=rc
                    espCache[uid.."_hl"].OutlineColor=rc
                end
            end
        end
    end
end
-- Player Logic
local function updP()
    pcall(function()
        local c=LP.Character
        local hum=getHum(c)
        if hum then
            pcall(function() hum.WalkSpeed=cfg.spd and cfg.spdV or 16 end)
            if cfg.jmp then
                pcall(function()
                    hum.JumpPower=cfg.jmpV
                    hum.UseJumpPower=true
                end)
            else
                pcall(function() hum.JumpPower=50 end)
            end
        end
        if cfg.noclip and c then
            for _,p in pairs(c:GetDescendants()) do
                pcall(function()
                    if p:IsA("BasePart") then p.CanCollide=false end
                end)
            end
        end
    end)
end

