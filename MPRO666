local function updateESP()
    if not cfg.esp then
        local toClear = {}
        for k, v in pairs(espCache) do
            if typeof(v) == "Instance" and not string.find(k, "_") then
                table.insert(toClear, k)
            end
        end
        for _, p in ipairs(toClear) do clearESP(p) end
        return
    end
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr == LP then continue end
        local char = plr.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        if hrp and hum and hum.Health > 0 then
            if not espCache[plr] then createESP(plr) end
            local bb = espCache[plr]
            if bb and bb.Parent then
                bb.Adornee = hrp
                local dist = (Cam.CFrame.Position - hrp.Position).Magnitude
                bb.Enabled = dist <= cfg.maxDist
                if espCache[plr.."_name"] then espCache[plr.."_name"].Visible = cfg.name end
                if espCache[plr.."_dist"] then
                    espCache[plr.."_dist"].Visible = cfg.dist
                    espCache[plr.."_dist"].Text = math.floor(dist).." studs"
                end
                if espCache[plr.."_hb"] and espCache[plr.."_hf"] then
                    espCache[plr.."_hb"].Visible = cfg.hp
                    local pc = hum.Health / hum.MaxHealth
                    espCache[plr.."_hf"].Size = UDim2.new(pc,0,1,0)
                    espCache[plr.."_hf"].BackgroundColor3 = pc>0.6 and Color3.fromRGB(0,255,100) or pc>0.3 and Color3.fromRGB(255,200,0) or Color3.fromRGB(255,50,50)
                end
                if espCache[plr.."_hl"] then
                    espCache[plr.."_hl"].Adornee = (cfg.aura and dist <= cfg.maxDist) and char or nil
                end
            end
        else
            clearESP(plr)
        end
    end
end

-- Player
local function updatePlayer()
    local char = LP.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if hum then
        hum.WalkSpeed = cfg.spd and cfg.spdV or 16
        if cfg.jmp then hum.JumpPower = cfg.jmpV hum.UseJumpPower = true
        else hum.JumpPower = 50 end
    end
    if cfg.noclip and char then
        for _, p in pairs(char:GetDescendants()) do
            if p:IsA("BasePart") and p.CanCollide then p.CanCollide = false end
        end
    end
end

