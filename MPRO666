local cur="VISUAL"
local tabs={}

local function switchTab(n)
    cur=n
    for k,v in pairs(tabs) do
        if k==n then
            v.BackgroundColor3=C.accent
            v.TextColor3=C.bg
        else
            v.BackgroundColor3=C.panel
            v.TextColor3=C.dim
        end
    end
    for _,c in pairs(sc:GetChildren()) do
        local t=c:GetAttribute("Tab")
        if t then c.Visible=(t==n) end
    end
end

