local function getTarget()
    local closest = nil
    local shortest = cfg.aimRange
    local myChar = LP.Character
    local myHRP = myChar and myChar:FindFirstChild("HumanoidRootPart")
    if not myHRP then return nil end
    local camLook = Cam.CFrame.LookVector
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr == LP then continue end
        local char = plr.Character
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        local tp = char and char:FindFirstChild(cfg.aimPart)
        if tp and hum and hum.Health > 0 then
            local dist = (myHRP.Position - tp.Position).Magnitude
            if dist < shortest then
                local dir = (tp.Position - Cam.CFrame.Position).Unit
                local dot = camLook:Dot(dir)
                local ang = math.deg(math.acos(math.clamp(dot, -1, 1)))
                if ang <= cfg.aimFOV/2 then
                    shortest = dist
                    closest = tp
                end
            end
        end
    end
    return closest
end

local function aimLock()
    if not cfg.aim then return end
    local target = getTarget()
    if not target then return end
    local myChar = LP.Character
    local myHRP = myChar and myChar:FindFirstChild("HumanoidRootPart")
    if not myHRP then return end
    local myPos = Cam.CFrame.Position
    local dir = (target.Position - myPos).Unit
    local targetCF = CFrame.new(myPos, myPos + dir)
    local smooth = math.clamp(cfg.aimSmooth, 0.01, 1)
    Cam.CFrame = Cam.CFrame:Lerp(targetCF, smooth)
end

