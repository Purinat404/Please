-- ซ่อนผู้เล่นคนอื่นทั้งหมด
local function hidePlayer(plr)
    if plr==LP then return end
    pcall(function()
        if plr.Character then
            for _,o in pairs(plr.Character:GetDescendants()) do
                pcall(function()
                    if o:IsA("BasePart") then
                        o.LocalTransparencyModifier=1
                        o.CanCollide=false
                    end
                    if o:IsA("Accessory") or o:IsA("Decal") or o:IsA("Texture") or o:IsA("ParticleEmitter") or o:IsA("Trail") or o:IsA("Beam") then
                        o:Destroy()
                    end
                end)
            end
        end
    end)
end

for _,plr in pairs(P:GetPlayers()) do hidePlayer(plr) end

P.PlayerAdded:Connect(function(plr)
    plr.CharacterAdded:Connect(function()
        task.wait(0.3)
        hidePlayer(plr)
    end)
end)

for _,plr in pairs(P:GetPlayers()) do
    if plr~=LP then
        plr.CharacterAdded:Connect(function()
            task.wait(0.3)
            hidePlayer(plr)
        end)
    end
end

