-- ฟังก์ชันหา Humanoid
local function getHum(char)
    if not char then return nil end
    return char:FindFirstChildOfClass("Humanoid") or char:FindFirstChild("Humanoid")
end

-- ฟังก์ชันหา HRP
local function getHRP(char)
    if not char then return nil end
    return char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("UpperTorso") or char:FindFirstChild("Torso") or char:FindFirstChildOfClass("BasePart")
end

-- ลบ ESP
local function clearESP(plr)
    local uid=plr.UserId
    local ks={uid,uid.."_bb",uid.."_bs",uid.."_n",uid.."_d",uid.."_hb",uid.."_hf",uid.."_hl"}
    for _,k in ipairs(ks) do
        if espCache[k] then
            pcall(function() espCache[k]:Destroy() end)
            espCache[k]=nil
        end
    end
end
