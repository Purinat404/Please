local LG=game:GetService("Lighting")
local P=game:GetService("Players")
local LP=P.LocalPlayer
local WS=workspace
print("[NX NUKE] เริ่มลบทุกอย่าง...")

-- ลบทุกอย่างที่มีใน Workspace
task.spawn(function()
    for _,o in pairs(WS:GetDescendants()) do
        pcall(function()
            if o:IsA("Texture") or o:IsA("Decal") or o:IsA("SurfaceAppearance") 
            or o:IsA("ParticleEmitter") or o:IsA("Fire") or o:IsA("Smoke") 
            or o:IsA("Sparkles") or o:IsA("Beam") or o:IsA("Trail") 
            or o:IsA("SpecialMesh") or o:IsA("Mesh") or o:IsA("CylinderMesh") 
            or o:IsA("BlockMesh") or o:IsA("SphereMesh") or o:IsA("WedgeMesh")
            or o:IsA("PointLight") or o:IsA("SpotLight") or o:IsA("SurfaceLight")
            or o:IsA("Sound") or o:IsA("Highlight") or o:IsA("SelectionBox")
            or o:IsA("BillboardGui") or o:IsA("SurfaceGui") or o:IsA("ScreenGui") then
                o:Destroy()
            end
        end)
    end
end)

-- ลบ Effect Lighting
for _,v in pairs(LG:GetChildren()) do
    pcall(function()
        if v:IsA("Sky") or v:IsA("Atmosphere") or v:IsA("PostEffect") 
        or v:IsA("BloomEffect") or v:IsA("BlurEffect") or v:IsA("SunRaysEffect") 
        or v:IsA("DepthOfFieldEffect") or v:IsA("ColorCorrectionEffect") 
        or v:IsA("ColorGradingEffect") or v:IsA("Clouds") then
            v:Destroy()
        end
    end)
end

-- ปรับ Lighting
pcall(function()
    LG.GlobalShadows=false
    LG.FogEnd=0
    LG.FogStart=0
    LG.Brightness=2
    LG.EnvironmentDiffuseScale=0
    LG.EnvironmentSpecularScale=0
    LG.Ambient=Color3.fromRGB(180,180,180)
    LG.OutdoorAmbient=Color3.fromRGB(180,180,180)
    LG.ClockTime=14
end)

-- น้ำเรียบสุด
pcall(function()
    local t=WS:FindFirstChildOfClass("Terrain")
    if t then
        t.WaterWaveSize=0
        t.WaterWaveSpeed=0
        t.WaterReflectance=0
        t.WaterTransparency=1
        t.Decoration=false
    end
end)

-- ลดคุณภาพต่ำสุด
pcall(function()
    settings().Rendering.QualityLevel=Enum.QualityLevel.Level01
    settings().Rendering.MeshPartDetailLevel=Enum.MeshPartDetailLevel.Level01
    settings().Physics.ThrottleAdjustTime=0
    settings().Physics.AllowSleep=true
    settings().Rendering.EnableFRM=false
    settings().Rendering.EnableBatching=true
end)

-- ซ่อนคนอื่นทั้งหมด (โปร่งใส)
local function hide(plr)
    if plr==LP then return end
    pcall(function()
        if plr.Character then
            for _,o in pairs(plr.Character:GetDescendants()) do
                pcall(function()
                    if o:IsA("BasePart") then
                        o.LocalTransparencyModifier=1
                        o.CanCollide=false
                    end
                    if o:IsA("Accessory") or o:IsA("Decal") or o:IsA("Texture") 
                    or o:IsA("ParticleEmitter") or o:IsA("Trail") or o:IsA("Beam")
                    or o:IsA("Sound") or o:IsA("BillboardGui") or o:IsA("SurfaceGui") then
                        o:Destroy()
                    end
                end)
            end
        end
    end)
end

for _,plr in pairs(P:GetPlayers()) do hide(plr) end

P.PlayerAdded:Connect(function(plr)
    plr.CharacterAdded:Connect(function()
        task.wait(0.3)
        hide(plr)
    end)
end)

for _,plr in pairs(P:GetPlayers()) do
    if plr~=LP then
        plr.CharacterAdded:Connect(function()
            task.wait(0.3)
            hide(plr)
        end)
    end
end

-- ลบ Effect ตัวเอง
pcall(function()
    local c=LP.Character
    if c then
        for _,o in pairs(c:GetDescendants()) do
            pcall(function()
                if o:IsA("Accessory") or o:IsA("ParticleEmitter") or o:IsA("Trail") 
                or o:IsA("Beam") or o:IsA("Sound") then
                    o:Destroy()
                end
            end)
        end
    end
end)

