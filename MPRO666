-- NX Boost MAX - By Purinat
local LG=game:GetService("Lighting")
local P=game:GetService("Players")
local LP=P.LocalPlayer
local WS=workspace
local CG=game:GetService("CoreGui")
print("[NX Boost MAX] เริ่มบูสสูงสุด...")

-- 1. ลบ Texture/Decal ทั้งหมด
for _,o in pairs(WS:GetDescendants()) do
    pcall(function()
        if o:IsA("Texture") or o:IsA("Decal") or o:IsA("SurfaceAppearance") then
            o:Destroy()
        end
    end)
end

-- 2. ลบ Particle/ไฟ/ควัน/Beam/Trail/Sparkles
for _,o in pairs(WS:GetDescendants()) do
    pcall(function()
        if o:IsA("ParticleEmitter") or o:IsA("Fire") or o:IsA("Smoke") or o:IsA("Sparkles") or o:IsA("Beam") or o:IsA("Trail") then
            o:Destroy()
        end
    end)
end

-- 3. ลบ Mesh ทั้งหมด
for _,o in pairs(WS:GetDescendants()) do
    pcall(function()
        if o:IsA("SpecialMesh") or o:IsA("Mesh") or o:IsA("CylinderMesh") or o:IsA("BlockMesh") or o:IsA("SphereMesh") then
            o:Destroy()
        end
    end)
end

-- 4. ลบ Sky/Atmosphere/Effect ทั้งหมดใน Lighting
for _,v in pairs(LG:GetChildren()) do
    pcall(function()
        if v:IsA("Sky") or v:IsA("Atmosphere") or v:IsA("PostEffect") or v:IsA("BloomEffect") or v:IsA("BlurEffect") or v:IsA("SunRaysEffect") or v:IsA("DepthOfFieldEffect") or v:IsA("ColorCorrectionEffect") or v:IsA("ColorGradingEffect") then
            v:Destroy()
        end
    end)
end

-- 5. ปรับ Lighting
pcall(function()
    LG.GlobalShadows=false
    LG.FogEnd=100000
    LG.FogStart=100000
    LG.Brightness=2
    LG.EnvironmentDiffuseScale=0
    LG.EnvironmentSpecularScale=0
    LG.Ambient=Color3.fromRGB(150,150,150)
    LG.OutdoorAmbient=Color3.fromRGB(150,150,150)
    LG.ClockTime=14
end)

-- 6. น้ำเรียบ + Terrain
pcall(function()
    local t=WS:FindFirstChildOfClass("Terrain")
    if t then
        t.WaterWaveSize=0
        t.WaterWaveSpeed=0
        t.WaterReflectance=0
        t.WaterTransparency=0.5
        t.Decoration=false
    end
end)

-- 7. ลดคุณภาพต่ำสุด
pcall(function()
    settings().Rendering.QualityLevel=Enum.QualityLevel.Level01
    settings().Rendering.MeshPartDetailLevel=Enum.MeshPartDetailLevel.Level01
    settings().Physics.ThrottleAdjustTime=0
    settings().Physics.AllowSleep=true
    settings().Physics.PhysicsEnvironmentalThrottle=Enum.EnviromentalPhysicsThrottle.DefaultAuto
end)

-- 8. ลบ Effect/Trail/Light ในตัวละครทุกคน
for _,plr in pairs(P:GetPlayers()) do
    pcall(function()
        local c=plr.Character
        if c then
            for _,o in pairs(c:GetDescendants()) do
                pcall(function()
                    if o:IsA("Accessory") or o:IsA("Hat") or o:IsA("ParticleEmitter") or o:IsA("Trail") or o:IsA("Beam") or o:IsA("PointLight") or o:IsA("SpotLight") or o:IsA("SurfaceLight") or o:IsA("Decal") or o:IsA("Texture") then
                        o:Destroy()
                    end
                end)
            end
        end
    end)
end

-- 9. ลบ Decal ใน CoreGui
pcall(function()
    for _,o in pairs(CG:GetDescendants()) do
        pcall(function()
            if o:IsA("ImageLabel") and o.Image~="" then
                -- ไม่ลบ ลดความโปร่งใส
            end
        end)
    end
end)

-- 10. ลบ Sound ทั้งหมด
for _,o in pairs(WS:GetDescendants()) do
    pcall(function()
        if o:IsA("Sound") then o:Volume=0 end
    end)
end

-- 11. Anti-AFK
LP.Idled:Connect(function()
    pcall(function()
        game:GetService("VirtualUser"):CaptureController()
        game:GetService("VirtualUser"):ClickButton2(Vector2.new())
    end)
end)

-- 12. ปิด Light ทุกจุดในเกม
for _,o in pairs(WS:GetDescendants()) do
    pcall(function()
        if o:IsA("PointLight") or o:IsA("SpotLight") or o:IsA("SurfaceLight") then
            o.Enabled=false
        end
    end)
end

-- 13. ลดความละเอียด Texture ซ้ำ
pcall(function()
    settings().Rendering.QualityLevel=Enum.QualityLevel.Level01
end)

print("[NX Boost MAX] เสร็จ! ลบทุกอย่างที่ลบได้")
print("FPS ควรเพิ่ม 30-50")
