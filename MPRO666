-- Tab system
local currentTab = "VISUAL"
local tabButtons = {}
local function switchTab(name)
    currentTab = name
    for tName, tBtn in pairs(tabButtons) do
        if tName == name then
            tBtn.BackgroundColor3 = Color3.fromRGB(255,50,50)
            tBtn.TextColor3 = Color3.fromRGB(255,255,255)
        else
            tBtn.BackgroundColor3 = Color3.fromRGB(30,12,12)
            tBtn.TextColor3 = Color3.fromRGB(200,130,130)
        end
    end
    for _, child in pairs(sc:GetChildren()) do
        if child:IsA("Frame") or child:IsA("TextLabel") then
            local tab = child:GetAttribute("Tab")
            if tab then
                child.Visible = (tab == name)
            end
        end
    end
end

