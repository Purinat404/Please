    hbc.Parent = hb

    local hf = Instance.new("Frame")
    hf.Size = UDim2.new(1, 0, 1, 0)
    hf.BackgroundColor3 = Color3.fromRGB(0, 255, 100)
    hf.BorderSizePixel = 0
    hf.Parent = hb

    local hfc = Instance.new("UICorner")
    hfc.CornerRadius = UDim.new(1, 0)
    hfc.Parent = hf

    local hl = Instance.new("Highlight")
    hl.FillColor = Color3.fromRGB(255, 50, 50)
    hl.FillTransparency = 0.6
    hl.OutlineColor = Color3.fromRGB(255, 100, 100)
    hl.OutlineTransparency = 0
    hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    hl.Parent = gui

    espCache[plr] = bb
    espCache[plr.."_name"] = nameL
    espCache[plr.."_dist"] = distL
    espCache[plr.."_hb"] = hb
    espCache[plr.."_hf"] = hf
    espCache[plr.."_hl"] = hl
end

local function updateESP()
    if not cfg.esp then
        local toClear = {}
        for k, v in pairs(espCache) do
            if typeof(v) == "Instance" and not string.find(k, "_") then
                table.insert(toClear, k)
            end
        end
        for _, p in ipairs(toClear) do
            clearESP(p)
        end
        return
    end

    for _, plr in ipairs(Players:GetPlayers()) do
        if plr == LP then continue end
        local char = plr.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        local hum = char and char:FindFirstChildOfClass("Humanoid")

        if hrp and hum and hum.Health > 0 then
            if not espCache[plr] then createESP(plr) end
            local bb = espCache[plr]
            if bb and bb.Parent then
                bb.Adornee = hrp
                local dist = (Cam.CFrame.Position - hrp.Position).Magnitude
                bb.Enabled = dist <= cfg.maxDist

                local nl = espCache[plr.."_name"]
                if nl then nl.Visible = cfg.name end

                local dl = espCache[plr.."_dist"]
                if dl then
                    dl.Visible = cfg.dist
                    dl.Text = math.floor(dist) .. " studs"
                end

                local hb = espCache[plr.."_hb"]
                local hf = espCache[plr.."_hf"]
                if hb and hf then
                    hb.Visible = cfg.hp
                    local percent = hum.Health / hum.MaxHealth
                    hf.Size = UDim2.new(percent, 0, 1, 0)
                    if percent > 0.6 then
                        hf.BackgroundColor3 = Color3.fromRGB(0, 255, 100)
                    elseif percent > 0.3 then
                        hf.BackgroundColor3 = Color3.fromRGB(255, 200, 0)
                    else
                        hf.BackgroundColor3 = Color3.fromRGB(255, 50, 50)
                    end
                end

                local hl = espCache[plr.."_hl"]
                if hl then
                    if cfg.aura and dist <= cfg.maxDist then
                        hl.Adornee = char
                    else
                        hl.Adornee = nil
                    end
                end
            end
        else
            clearESP(plr)
        end
    end
end

-- ===== Player Logic =====
local function updatePlayer()
    local char = LP.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if hum then
        hum.WalkSpeed = cfg.spd and cfg.spdV or 16
        if cfg.jmp then
            hum.JumpPower = cfg.jmpV
            hum.UseJumpPower = true
        else
            hum.JumpPower = 50
        end
    end
end

