local espCache = {}

local function clearESP(plr)
    local keys = {plr, plr.."_name", plr.."_hb", plr.."_hf", plr.."_hl"}
    for _, k in ipairs(keys) do
        if espCache[k] then
            pcall(function() espCache[k]:Destroy() end)
            espCache[k] = nil
        end
    end
end

local function createESP(plr)
