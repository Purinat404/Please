-- ESP 3D System
local ec={}
local hue=0

local function gH(x) if not x then return nil end return x:FindFirstChildOfClass("Humanoid") or x:FindFirstChild("Humanoid") end
local function gR(x) if not x then return nil end return x:FindFirstChild("HumanoidRootPart") or x:FindFirstChild("UpperTorso") or x:FindFirstChild("Torso") or x:FindFirstChildOfClass("BasePart") end

local function clr(p)
    local u=p.UserId
    local ks={u,u.."_n",u.."_d",u.."_hb",u.."_hf",u.."_hl"}
    for i=1,12 do table.insert(ks,u.."_e"..i) end
    for _,k in ipairs(ks) do
        if ec[k] then
            pcall(function() ec[k]:Destroy() end)
            ec[k]=nil
        end
    end
end

local function mk(p)
    if p==LP then return end
    clr(p)
    local u=p.UserId

    -- 12 edges for 3D box
    local edges={}
    for i=1,12 do
        local line=Instance.new("Frame")
        line.BackgroundColor3=A
        line.BorderSizePixel=0
        line.ZIndex=3
        line.Visible=false
        line.Parent=g
        local lnc=Instance.new("UICorner")
        lnc.CornerRadius=UDim.new(1,0)
        lnc.Parent=line
        edges[i]=line
        ec[u.."_e"..i]=line
    end

    local n=Instance.new("TextLabel")
    n.BackgroundTransparency=1
    n.Text=p.Name
    n.TextColor3=TX
    n.TextStrokeTransparency=0
    n.TextStrokeColor3=Color3.fromRGB(0,0,0)
    n.TextSize=12
    n.Font=Enum.Font.GothamBold
    n.ZIndex=5
    n.Parent=g

    local d=Instance.new("TextLabel")
    d.BackgroundTransparency=1
    d.Text=""
    d.TextColor3=DM
    d.TextStrokeTransparency=0
    d.TextStrokeColor3=Color3.fromRGB(0,0,0)
    d.TextSize=11
    d.Font=Enum.Font.Code
    d.ZIndex=5
    d.Parent=g

    local hl=Instance.new("Highlight")
    hl.FillColor=A
    hl.FillTransparency=0.7
    hl.OutlineColor=B
    hl.OutlineTransparency=0.2
    hl.DepthMode=Enum.HighlightDepthMode.AlwaysOnTop
    hl.Parent=g

    ec[u]=true
    ec[u.."_n"]=n
    ec[u.."_d"]=d
    ec[u.."_hl"]=hl
end

local function upE()
    hue=(hue+0.008)%1
    if not c.esp then
        for _,p in ipairs(P:GetPlayers()) do
            if p~=LP then clr(p) end
        end
        return
    end
    for _,p in ipairs(P:GetPlayers()) do
        if p==LP then continue end
        local ch=p.Character
        if not ch then continue end
        local hr=gR(ch)
        local hu=gH(ch)
        if not hr or not hu then continue end
        local u=p.UserId
        if not ec[u] then mk(p) task.wait(0.03) end
        local di=(CM.CFrame.Position-hr.Position).Magnitude
        if di>c.md then
            for i=1,12 do
                if ec[u.."_e"..i] then ec[u.."_e"..i].Visible=false end
            end
            if ec[u.."_n"] then ec[u.."_n"].Visible=false end
            if ec[u.."_d"] then ec[u.."_d"].Visible=false end
            if ec[u.."_hl"] then ec[u.."_hl"].Adornee=nil end
            continue
        end
        local rc=A
        if c.rb then rc=Color3.fromHSV(hue,0.9,1) end

        -- 3D Box
        if c.box3d then
            local cf=hr.CFrame
            local pts={
                cf*Vector3.new(-1.5,3,-1),
                cf*Vector3.new(1.5,3,-1),
                cf*Vector3.new(-1.5,-3,-1),
                cf*Vector3.new(1.5,-3,-1),
                cf*Vector3.new(-1.5,3,1),
                cf*Vector3.new(1.5,3,1),
                cf*Vector3.new(-1.5,-3,1),
                cf*Vector3.new(1.5,-3,1)
            }
            local sp={}
            for i=1,8 do
                local vp,on=CM:WorldToViewportPoint(pts[i])
                sp[i]={x=vp.X,y=vp.Y,on=on}
            end
            local segs={{1,2},{3,4},{5,6},{7,8},{1,3},{2,4},{5,7},{6,8},{1,5},{2,6},{3,7},{4,8}}
            for i=1,12 do
                local seg=segs[i]
                local a=sp[seg[1]]
                local b=sp[seg[2]]
                local line=ec[u.."_e"..i]
                if line and a and b and a.on and b.on then
                    local dx=b.x-a.x
                    local dy=b.y-a.y
                    local len=math.sqrt(dx*dx+dy*dy)
                    local ang=math.deg(math.atan2(dy,dx))
                    line.Visible=true
                    line.Size=UDim2.new(0,len,0,1.5)
                    line.Position=UDim2.new(0,a.x,0,a.y)
                    line.Rotation=ang
                    line.BackgroundColor3=rc
                elseif line then
                    line.Visible=false
                end
            end
            if ec[u.."_n"] then
                local top=sp[1]
                if top and top.on then
                    ec[u.."_n"].Visible=c.nm
                    ec[u.."_n"].Text=p.Name
                    ec[u.."_n"].TextColor3=rc
                    ec[u.."_n"].Size=UDim2.new(0,200,0,16)
                    ec[u.."_n"].Position=UDim2.new(0,top.x-100,0,top.y-22)
                end
            end
            if ec[u.."_d"] then
                local bot=sp[3]
                if bot and bot.on then
                    ec[u.."_d"].Visible=c.ds
                    ec[u.."_d"].Text=math.floor(di).." studs"
                    ec[u.."_d"].Size=UDim2.new(0,200,0,14)
                    ec[u.."_d"].Position=UDim2.new(0,bot.x-100,0,bot.y+4)
                end
            end
        else
            for i=1,12 do
                if ec[u.."_e"..i] then ec[u.."_e"..i].Visible=false end
            end
        end

        if ec[u.."_hl"] then
            ec[u.."_hl"].Adornee=(c.aura and di<=c.md) and ch or nil
            ec[u.."_hl"].FillColor=rc
            ec[u.."_hl"].OutlineColor=rc
        end
    end
end

