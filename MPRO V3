    hl.FillColor=A
    hl.FillTransparency=0.7
    hl.OutlineColor=B
    hl.OutlineTransparency=0.2
    hl.DepthMode=Enum.HighlightDepthMode.AlwaysOnTop
    hl.Parent=g
    ec[u.."_hl"]=hl
    ec[u]=true
end
local function upE()
    hue=(hue+0.008)%1
    if not c.esp then
        for _,p in ipairs(P:GetPlayers()) do if p~=LP then clr(p) end end
        return
    end
    for _,p in ipairs(P:GetPlayers()) do
        if p==LP then continue end
        local ch=p.Character
        if not ch then continue end
        local hr=gR(ch)
        local hu=gH(ch)
        if not hr or not hu then continue end
        local u=p.UserId
        if not ec[u] then mk(p) task.wait(0.03) end
        local di=(CM.CFrame.Position-hr.Position).Magnitude
        if di>c.md then
            for i=1,12 do if ec[u.."_e"..i] then ec[u.."_e"..i].Visible=false end end
            if ec[u.."_n"] then ec[u.."_n"].Visible=false end
            if ec[u.."_d"] then ec[u.."_d"].Visible=false end
            if ec[u.."_hl"] then ec[u.."_hl"].Adornee=nil end
            continue
        end
        local rc=A
        if c.rb then rc=Color3.fromHSV(hue,0.9,1) end
        if c.box3d then
            local cf=hr.CFrame
            local pts={
                cf*Vector3.new(-1.5,3,-1),
                cf*Vector3.new(1.5,3,-1),
                cf*Vector3.new(-1.5,-3,-1),
                cf*Vector3.new(1.5,-3,-1),
                cf*Vector3.new(-1.5,3,1),
                cf*Vector3.new(1.5,3,1),
                cf*Vector3.new(-1.5,-3,1),
                cf*Vector3.new(1.5,-3,1)
            }
            local sp={}
            for i=1,8 do
                local vp,on=CM:WorldToViewportPoint(pts[i])
                sp[i]={x=vp.X,y=vp.Y,on=on}
            end
            local segs={{1,2},{3,4},{5,6},{7,8},{1,3},{2,4},{5,7},{6,8},{1,5},{2,6},{3,7},{4,8}}
            for i=1,12 do
                local sg=segs[i]
                local a=sp[sg[1]]
                local b=sp[sg[2]]
                local line=ec[u.."_e"..i]
                if line and a and b and a.on and b.on then
                    local dx=b.x-a.x
                    local dy=b.y-a.y
                    local len=math.sqrt(dx*dx+dy*dy)
                    local ang=math.deg(math.atan2(dy,dx))
                    line.Visible=true
                    line.Size=UDim2.new(0,len,0,1.5)
                    line.Position=UDim2.new(0,a.x,0,a.y)
                    line.Rotation=ang
                    line.BackgroundColor3=rc
                elseif line then
                    line.Visible=false
                end
            end
            if ec[u.."_n"] then
                local tp=sp[1]
                if tp and tp.on then
                    ec[u.."_n"].Visible=c.nm
                    ec[u.."_n"].TextColor3=rc
                    ec[u.."_n"].Size=UDim2.new(0,200,0,16)
                    ec[u.."_n"].Position=UDim2.new(0,tp.x-100,0,tp.y-22)
                end
            end
            if ec[u.."_d"] then
                local bt=sp[3]
                if bt and bt.on then
                    ec[u.."_d"].Visible=c.ds
                    ec[u.."_d"].Text=math.floor(di).." studs"
                    ec[u.."_d"].Size=UDim2.new(0,200,0,14)
                    ec[u.."_d"].Position=UDim2.new(0,bt.x-100,0,bt.y+4)
                end
            end
        else
            for i=1,12 do if ec[u.."_e"..i] then ec[u.."_e"..i].Visible=false end end
        end
        if ec[u.."_hl"] then
            ec[u.."_hl"].Adornee=(c.aura and di<=c.md) and ch or nil
            ec[u.."_hl"].FillColor=rc
            ec[u.."_hl"].OutlineColor=rc
        end
    end
end
local function upP()
    pcall(function()
        local x=LP.Character
        local hu=gH(x)
        if hu then
            pcall(function() hu.WalkSpeed=c.spd and c.sv or 16 end)
            if c.jmp then pcall(function() hu.JumpPower=c.jv hu.UseJumpPower=true end)
            else pcall(function() hu.JumpPower=50 end) end
        end
        if c.nc and x then
            for _,p in pairs(x:GetDescendants()) do
                pcall(function() if p:IsA("BasePart") then p.CanCollide=false end end)
            end
        end
    end)
end
