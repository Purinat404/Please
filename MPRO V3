local function sli(t,mn2,mx,d,cb)
    local r=Instance.new("Frame")
    r.Size=UDim2.new(1,-8,0,50)
    r.BackgroundColor3=PN
    r.BorderSizePixel=0
    r.Parent=sc
    local rc=Instance.new("UICorner") rc.CornerRadius=UDim.new(0,8) rc.Parent=r
    local l=Instance.new("TextLabel")
    l.Size=UDim2.new(1,-20,0,18)
    l.Position=UDim2.new(0,12,0,5)
    l.BackgroundTransparency=1
    l.Text=t..": "..d
    l.TextColor3=TX
    l.TextSize=12
    l.Font=Enum.Font.Code
    l.TextXAlignment=Enum.TextXAlignment.Left
    l.Parent=r
    local b=Instance.new("Frame")
    b.Size=UDim2.new(1,-24,0,6)
    b.Position=UDim2.new(0,12,0,34)
    b.BackgroundColor3=Color3.fromRGB(45,20,40)
    b.BorderSizePixel=0
    b.Parent=r
    local bc2=Instance.new("UICorner") bc2.CornerRadius=UDim.new(1,0) bc2.Parent=b
    local f=Instance.new("Frame")
    f.Size=UDim2.new((d-mn2)/(mx-mn2),0,1,0)
    f.BackgroundColor3=A
    f.BorderSizePixel=0
    f.Parent=b
    local fc=Instance.new("UICorner") fc.CornerRadius=UDim.new(1,0) fc.Parent=f
    local dr=false
    local function up(x)
        local rl=math.clamp((x-b.AbsolutePosition.X)/b.AbsoluteSize.X,0,1)
        local v=math.floor(mn2+(mx-mn2)*rl)
        f.Size=UDim2.new(rl,0,1,0)
        l.Text=t..": "..v
        if cb then pcall(cb,v) end
    end
    b.InputBegan:Connect(function(i)
        if i.UserInputType==Enum.UserInputType.MouseButton1 or i.UserInputType==Enum.UserInputType.Touch then
            dr=true up(i.Position.X)
        end
    end)
    b.InputEnded:Connect(function(i)
        if i.UserInputType==Enum.UserInputType.MouseButton1 or i.UserInputType==Enum.UserInputType.Touch then
            dr=false
        end
    end)
    UI.InputChanged:Connect(function(i)
        if dr and (i.UserInputType==Enum.UserInputType.MouseMovement or i.UserInputType==Enum.UserInputType.Touch) then
            up(i.Position.X)
        end
    end)
end
