local function gT()
    local cl=nil
    local sh=c.ar
    local mc=LP.Character
    local mh=gR(mc)
    if not mh then return nil end
    local ck=CM.CFrame.LookVector
    for _,p in ipairs(P:GetPlayers()) do
        if p==LP then continue end
        local x=p.Character
        local hu=gH(x)
        local tp=x and (x:FindFirstChild("Head") or gR(x))
        if tp and hu and (hu.Health or 1)>0 then
            local d=(mh.Position-tp.Position).Magnitude
            if d<sh then
                local di=(tp.Position-CM.CFrame.Position).Unit
                local dt=ck:Dot(di)
                local an=math.deg(math.acos(math.clamp(dt,-1,1)))
                if an<=c.af/2 then sh=d cl=tp end
            end
        end
    end
    return cl
end
local function aimL()
    if not c.aim then return end
    local t=gT()
    if not t then return end
    local mc=LP.Character
    local mh=gR(mc)
    if not mh then return end
    local mp=CM.CFrame.Position
    local di=(t.Position-mp).Unit
    local tC=CFrame.new(mp,mp+di)
    local sm=math.clamp(c.as,0.01,1)
    CM.CFrame=CM.CFrame:Lerp(tC,sm)
end
