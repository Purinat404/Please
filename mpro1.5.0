local mOpen=false
local function tgM() mOpen=not mOpen menu.Visible=mOpen end
btn.MouseButton1Click:Connect(tgM)
xb.MouseButton1Click:Connect(tgM)

local mDr=false
local mSt,mPo
hd.InputBegan:Connect(function(i) if i.UserInputType==Enum.UserInputType.MouseButton1 or i.UserInputType==Enum.UserInputType.Touch then mDr=true mSt=i.Position mPo=menu.Position end end)
UIS.InputChanged:Connect(function(i) if mDr and (i.UserInputType==Enum.UserInputType.MouseMovement or i.UserInputType==Enum.UserInputType.Touch) then local d=i.Position-mSt menu.Position=UDim2.new(mPo.X.Scale,mPo.X.Offset+d.X,mPo.Y.Scale,mPo.Y.Offset+d.Y) end end)
UIS.InputEnded:Connect(function(i) if i.UserInputType==Enum.UserInputType.MouseButton1 or i.UserInputType==Enum.UserInputType.Touch then mDr=false end end)

local aimCirc=Instance.new("Frame")
aimCirc.Size=UDim2.new(0,180,0,180)
aimCirc.Position=UDim2.new(0.5,-90,0.5,-90)
aimCirc.BackgroundTransparency=1
aimCirc.Visible=false
aimCirc.ZIndex=5
aimCirc.Parent=gui
local acC=Instance.new("UICorner") acC.CornerRadius=UDim.new(1,0) acC.Parent=aimCirc
local acS=Instance.new("UIStroke") acS.Thickness=2 acS.Color=C.ac acS.Transparency=0.3 acS.Parent=aimCirc

local ec={}
local hue=0
local function getH(c) if not c then return nil end return c:FindFirstChildOfClass("Humanoid") or c:FindFirstChild("Humanoid") end
local function getR(c) if not c then return nil end return c:FindFirstChild("HumanoidRootPart") or c:FindFirstChild("UpperTorso") or c:FindFirstChild("Torso") or c:FindFirstChildOfClass("BasePart") end
local function clr(p)
    local u=p.UserId
    for _,k in ipairs({u,u.."_bb",u.."_bs",u.."_n",u.."_d",u.."_hb",u.."_hf",u.."_hl"}) do
        if ec[k] then pcall(function() ec[k]:Destroy() end) ec[k]=nil end
    end
end
local function mk(p)
    if p==LP then return end
    clr(p)
    local u=p.UserId
    local bb=Instance.new("BillboardGui")
    bb.Size=UDim2.new(0,80,0,120)
    bb.StudsOffset=Vector3.new(0,2,0)
    bb.AlwaysOnTop=true
    bb.MaxDistance=math.huge
    bb.LightInfluence=0
    bb.Parent=gui
    local bx=Instance.new("Frame")
    bx.Size=UDim2.new(1,0,1,0)
    bx.BackgroundTransparency=1
    bx.BorderSizePixel=0
    bx.Parent=bb
    local bs=Instance.new("UIStroke") bs.Thickness=2 bs.Color=C.ac bs.Parent=bx
    local n=Instance.new("TextLabel")
    n.Size=UDim2.new(1,0,0,16)
    n.Position=UDim2.new(0,0,1,4)
    n.BackgroundTransparency=1
    n.Text=p.Name
    n.TextColor3=C.tx
    n.TextStrokeTransparency=0
    n.TextSize=12
    n.Font=Enum.Font.GothamBold
    n.Parent=bb
    local d=Instance.new("TextLabel")
    d.Size=UDim2.new(1,0,0,14)
    d.Position=UDim2.new(0,0,1,22)
    d.BackgroundTransparency=1
    d.Text=""
    d.TextColor3=C.dm
    d.TextStrokeTransparency=0
    d.TextSize=11
    d.Font=Enum.Font.Code
    d.Parent=bb
    local hb=Instance.new("Frame")
    hb.Size=UDim2.new(0,60,0,6)
    hb.Position=UDim2.new(0.5,-30,1,40)
    hb.BackgroundColor3=Color3.fromRGB(30,15,45)
    hb.BorderSizePixel=0
    hb.Parent=bb
    local hbc=Instance.new("UICorner") hbc.CornerRadius=UDim.new(1,0) hbc.Parent=hb
    local hf=Instance.new("Frame")
    hf.Size=UDim2.new(1,0,1,0)
    hf.BackgroundColor3=Color3.fromRGB(0,255,100)
    hf.BorderSizePixel=0
    hf.Parent=hb
    local hfc=Instance.new("UICorner") hfc.CornerRadius=UDim.new(1,0) hfc.Parent=hf
    local hl=Instance.new("Highlight")
    hl.FillColor=C.ac
    hl.FillTransparency=0.7
    hl.OutlineColor=C.ac2
    hl.OutlineTransparency=0.2
    hl.DepthMode=Enum.HighlightDepthMode.AlwaysOnTop
    hl.Parent=gui
    ec[u]=bb
    ec[u.."_bb"]=bx
    ec[u.."_bs"]=bs
    ec[u.."_n"]=n
    ec[u.."_d"]=d
    ec[u.."_hb"]=hb
    ec[u.."_hf"]=hf
    ec[u.."_hl"]=hl
end
local function upE()
    hue=(hue+0.008)%1
    if not cfg.esp then
        local t={}
        for k,v in pairs(ec) do if typeof(v)=="Instance" then table.insert(t,k) end end
        for _,k in ipairs(t) do
            local u=tonumber(string.match(k,"%d+"))
            if u then for _,p in ipairs(Players:GetPlayers()) do if p.UserId==u then clr(p) break end end end
        end
        return
    end
    for _,p in ipairs(Players:GetPlayers()) do
        if p==LP then continue end
        local c=p.Character
        if not c then continue end
        local hr=getR(c)
        local hu=getH(c)
        if hr and hu then
            local u=p.UserId
            if not ec[u] then mk(p) task.wait(0.03) end
            local bb=ec[u]
            if bb and bb.Parent then
                bb.Adornee=hr
                local di=(Cam.CFrame.Position-hr.Position).Magnitude
                bb.Enabled=di<=cfg.md
                local s=math.clamp(500/math.max(di,1),0.3,2)
                bb.Size=UDim2.new(0,80*s,0,120*s)
                local rc=C.ac
                if cfg.rb then rc=Color3.fromHSV(hue,0.8,1) end
                if ec[u.."_bs"] then ec[u.."_bs"].Color=rc end
                if ec[u.."_n"] then ec[u.."_n"].Visible=cfg.nm ec[u.."_n"].TextColor3=rc end
                if ec[u.."_d"] then ec[u.."_d"].Visible=cfg.ds ec[u.."_d"].Text=math.floor(di).." studs" end
                if ec[u.."_hb"] and ec[u.."_hf"] then
                    ec[u.."_hb"].Visible=cfg.hp
                    local pc=(hu.Health or 100)/math.max(hu.MaxHealth or 100,1)
                    ec[u.."_hf"].Size=UDim2.new(math.clamp(pc,0,1),0,1,0)
                    ec[u.."_hf"].BackgroundColor3=pc>0.6 and Color3.fromRGB(0,255,100) or pc>0.3 and Color3.fromRGB(255,200,0) or Color3.fromRGB(255,50,50)
                end
                if ec[u.."_hl"] then
                    ec[u.."_hl"].Adornee=(cfg.aura and di<=cfg.md) and c or nil
                    ec[u.."_hl"].FillColor=rc
                    ec[u.."_hl"].OutlineColor=rc
                end
            end
        end
    end
end

local function upP()
    pcall(function()
        local c=LP.Character
        local hu=getH(c)
        if hu then
            pcall(function() hu.WalkSpeed=cfg.spd and cfg.sv or 16 end)
            if cfg.jmp then pcall(function() hu.JumpPower=cfg.jv hu.UseJumpPower=true end)
            else pcall(function() hu.JumpPower=50 end) end
        end
        if cfg.nc and c then
            for _,p in pairs(c:GetDescendants()) do pcall(function() if p:IsA("BasePart") then p.CanCollide=false end end) end
        end
    end)
end

UIS.JumpRequest:Connect(function()
    pcall(function()
        if cfg.ij then
            local c=LP.Character
            local hu=getH(c)
            if hu then hu:ChangeState(Enum.HumanoidStateType.Jumping) end
        end
    end)
end)

LP.Idled:Connect(function()
    pcall(function()
        if cfg.afk then
            game:GetService("VirtualUser"):CaptureController()
            game:GetService("VirtualUser"):ClickButton2(Vector2.new())
        end
    end)
end)

local function getT()
    local cl=nil
    local sh=cfg.ar
    local mc=LP.Character
    local mh=getR(mc)
    if not mh then return nil end
    local ck=Cam.CFrame.LookVector
    for _,p in ipairs(Players:GetPlayers()) do
        if p==LP then continue end
        local c=p.Character
        local hu=getH(c)
        local tp=c and (c:FindFirstChild("Head") or getR(c))
        if tp and hu and (hu.Health or 1)>0 then
            local d=(mh.Position-tp.Position).Magnitude
            if d<sh then
                local di=(tp.Position-Cam.CFrame.Position).Unit
                local dt=ck:Dot(di)
                local an=math.deg(math.acos(math.clamp(dt,-1,1)))
                if an<=cfg.af/2 then sh=d cl=tp end
            end
        end
    end
    return cl
end

local function aimL()
    if not cfg.aim then return end
    local t=getT()
    if not t then return end
    local mc=LP.Character
    local mh=getR(mc)
    if not mh then return end
    local mp=Cam.CFrame.Position
    local di=(t.Position-mp).Unit
    local tC=CFrame.new(mp,mp+di)
    local sm=math.clamp(cfg.as,0.01,1)
    Cam.CFrame=Cam.CFrame:Lerp(tC,sm)
end

RunService.RenderStepped:Connect(function()
    pcall(upE)
    pcall(upP)
    pcall(aimL)
    pcall(function()
        if cfg.aim and cfg.circ then
            aimCirc.Visible=true
            local sz=(cfg.af/90)*180
            aimCirc.Size=UDim2.new(0,sz,0,sz)
            aimCirc.Position=UDim2.new(0.5,-sz/2,0.5,-sz/2)
        else
            aimCirc.Visible=false
        end
    end)
end)

Players.PlayerRemoving:Connect(function(p) pcall(function() clr(p) end) end)
Players.PlayerAdded:Connect(function(p) pcall(function() p.CharacterAdded:Connect(function() task.wait(0.5) pcall(function() clr(p) end) end) end) end)

UIS.InputBegan:Connect(function(i,pr)
    if pr then return end
    pcall(function()
        if i.KeyCode==Enum.KeyCode.Escape and mOpen then tgM() end
        if i.KeyCode==Enum.KeyCode.Q then cfg.aim=not cfg.aim end
        if i.KeyCode==Enum.KeyCode.Insert then tgM() end
    end)
end)

swTab("VISUAL")

pcall(function()
    game:GetService("StarterGui"):SetCore("SendNotification",{Title="NEXUS",Text="By Purinat - พร้อมใช้งาน",Duration=5})
end)
