local tabs={}
local function swTab(n)
    for k,v in pairs(tabs) do
        v.BackgroundColor3=(k==n) and C.ac or C.panel
        v.TextColor3=(k==n) and C.bg or C.dm
    end
    for _,c in pairs(sc:GetChildren()) do
        local t=c:GetAttribute("Tab")
        if t then c.Visible=(t==n) end
    end
end

local function mTab(n,o)
    local b=Instance.new("TextButton")
    b.Size=UDim2.new(0,80,0,24)
    b.BackgroundColor3=C.panel
    b.Text=n
    b.TextColor3=C.dm
    b.TextSize=10
    b.Font=Enum.Font.Code
    b.AutoButtonColor=false
    b.BorderSizePixel=0
    b.LayoutOrder=o
    b.Parent=tf
    local c=Instance.new("UICorner") c.CornerRadius=UDim.new(0,6) c.Parent=b
    b.MouseButton1Click:Connect(function() swTab(n) end)
    tabs[n]=b
end

local function mSec(txt,tab)
    local l=Instance.new("TextLabel")
    l.Size=UDim2.new(1,-8,0,20)
    l.BackgroundTransparency=1
    l.Text="  ┌─ "..txt
    l.TextColor3=C.ac
    l.TextSize=11
    l.Font=Enum.Font.Code
    l.TextXAlignment=Enum.TextXAlignment.Left
    l:SetAttribute("Tab",tab)
    l.Parent=sc
end

local function mTog(txt,def,tab,cb)
    local r=Instance.new("Frame")
    r.Size=UDim2.new(1,-8,0,32)
    r.BackgroundColor3=C.panel
    r.BorderSizePixel=0
    r:SetAttribute("Tab",tab)
    r.Parent=sc
    local rc=Instance.new("UICorner") rc.CornerRadius=UDim.new(0,8) rc.Parent=r
    local lb=Instance.new("TextLabel")
    lb.Size=UDim2.new(1,-70,1,0)
    lb.Position=UDim2.new(0,12,0,0)
    lb.BackgroundTransparency=1
    lb.Text=txt
    lb.TextColor3=C.tx
    lb.TextSize=12
    lb.Font=Enum.Font.Code
    lb.TextXAlignment=Enum.TextXAlignment.Left
    lb.Parent=r
    local tg=Instance.new("TextButton")
    tg.Size=UDim2.new(0,42,0,20)
    tg.Position=UDim2.new(1,-52,0.5,-10)
    tg.BackgroundColor3=def and C.ac or Color3.fromRGB(40,25,55)
    tg.Text=""
    tg.AutoButtonColor=false
    tg.BorderSizePixel=0
    tg.Parent=r
    local tc=Instance.new("UICorner") tc.CornerRadius=UDim.new(1,0) tc.Parent=tg
    local kn=Instance.new("Frame")
    kn.Size=UDim2.new(0,16,0,16)
    kn.Position=def and UDim2.new(1,-18,0.5,-8) or UDim2.new(0,2,0.5,-8)
    kn.BackgroundColor3=Color3.fromRGB(255,255,255)
    kn.BorderSizePixel=0
    kn.Parent=tg
    local kc=Instance.new("UICorner") kc.CornerRadius=UDim.new(1,0) kc.Parent=kn
    local st=def
    tg.MouseButton1Click:Connect(function()
        st=not st
        Tween:Create(tg,TweenInfo.new(0.2),{BackgroundColor3=st and C.ac or Color3.fromRGB(40,25,55)}):Play()
        Tween:Create(kn,TweenInfo.new(0.2),{Position=st and UDim2.new(1,-18,0.5,-8) or UDim2.new(0,2,0.5,-8)}):Play()
        if cb then pcall(cb,st) end
    end)
end

local function mSli(txt,mn,mx,def,tab,cb)
    local r=Instance.new("Frame")
    r.Size=UDim2.new(1,-8,0,50)
    r.BackgroundColor3=C.panel
    r.BorderSizePixel=0
    r:SetAttribute("Tab",tab)
    r.Parent=sc
    local rc=Instance.new("UICorner") rc.CornerRadius=UDim.new(0,8) rc.Parent=r
    local lb=Instance.new("TextLabel")
    lb.Size=UDim2.new(1,-20,0,18)
    lb.Position=UDim2.new(0,12,0,5)
    lb.BackgroundTransparency=1
    lb.Text=txt..": "..def
    lb.TextColor3=C.tx
    lb.TextSize=12
    lb.Font=Enum.Font.Code
    lb.TextXAlignment=Enum.TextXAlignment.Left
    lb.Parent=r
    local br=Instance.new("Frame")
    br.Size=UDim2.new(1,-24,0,6)
    br.Position=UDim2.new(0,12,0,34)
    br.BackgroundColor3=Color3.fromRGB(40,25,55)
    br.BorderSizePixel=0
    br.Parent=r
    local bc2=Instance.new("UICorner") bc2.CornerRadius=UDim.new(1,0) bc2.Parent=br
    local fl=Instance.new("Frame")
    fl.Size=UDim2.new((def-mn)/(mx-mn),0,1,0)
    fl.BackgroundColor3=C.ac2
    fl.BorderSizePixel=0
    fl.Parent=br
    local fc=Instance.new("UICorner") fc.CornerRadius=UDim.new(1,0) fc.Parent=fl
    local dr=false
    local function up(x)
        local rl=math.clamp((x-br.AbsolutePosition.X)/br.AbsoluteSize.X,0,1)
        local v=math.floor(mn+(mx-mn)*rl)
        fl.Size=UDim2.new(rl,0,1,0)
        lb.Text=txt..": "..v
        if cb then pcall(cb,v) end
    end
    br.InputBegan:Connect(function(i) if i.UserInputType==Enum.UserInputType.MouseButton1 or i.UserInputType==Enum.UserInputType.Touch then dr=true up(i.Position.X) end end)
    br.InputEnded:Connect(function(i) if i.UserInputType==Enum.UserInputType.MouseButton1 or i.UserInputType==Enum.UserInputType.Touch then dr=false end end)
    UIS.InputChanged:Connect(function(i) if dr and (i.UserInputType==Enum.UserInputType.MouseMovement or i.UserInputType==Enum.UserInputType.Touch) then up(i.Position.X) end end)
end

mTab("VISUAL",1)
mTab("ESP",2)
mTab("PLAYER",3)
mTab("AIM",4)

mSec("VISUAL","VISUAL")
mTog("Fullbright",cfg.fb,"VISUAL",function(v) cfg.fb=v pcall(function() if v then Lighting.Ambient=Color3.fromRGB(180,180,180) Lighting.OutdoorAmbient=Color3.fromRGB(180,180,180) Lighting.Brightness=3 else Lighting.Ambient=Color3.fromRGB(70,70,70) Lighting.OutdoorAmbient=Color3.fromRGB(128,128,128) Lighting.Brightness=2 end end) end)
mTog("No Fog",cfg.fog,"VISUAL",function(v) cfg.fog=v pcall(function() if v then Lighting.FogEnd=100000 Lighting.FogStart=100000 end end) end)
mTog("X-Ray",cfg.xray,"VISUAL",function(v) cfg.xray=v task.spawn(function() for _,o in pairs(workspace:GetDescendants()) do pcall(function() if o:IsA("BasePart") then o.LocalTransparencyModifier=v and 0.7 or 0 end end) end end) end)
mSli("FOV",50,120,cfg.fov,"VISUAL",function(v) cfg.fov=v pcall(function() Cam.FieldOfView=v end) end)

mSec("ESP","ESP")
mTog("Enable",cfg.esp,"ESP",function(v) cfg.esp=v end)
mTog("Name",cfg.nm,"ESP",function(v) cfg.nm=v end)
mTog("Health",cfg.hp,"ESP",function(v) cfg.hp=v end)
mTog("Distance",cfg.ds,"ESP",function(v) cfg.ds=v end)
mTog("Aura",cfg.aura,"ESP",function(v) cfg.aura=v end)
mTog("Rainbow",cfg.rb,"ESP",function(v) cfg.rb=v end)
mSli("Max Dist",50,5000,cfg.md,"ESP",function(v) cfg.md=v end)

mSec("PLAYER","PLAYER")
