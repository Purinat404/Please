mSli("Speed Val",16,200,cfg.sv,"PLAYER",function(v) cfg.sv=v end)
mTog("Jump",cfg.jmp,"PLAYER",function(v) cfg.jmp=v end)
mSli("Jump Pow",50,300,cfg.jv,"PLAYER",function(v) cfg.jv=v end)
mTog("Inf Jump",cfg.ij,"PLAYER",function(v) cfg.ij=v end)
mTog("Anti-AFK",cfg.afk,"PLAYER",function(v) cfg.afk=v end)
mTog("No Clip",cfg.nc,"PLAYER",function(v) cfg.nc=v end)

mSec("AIM","AIM")
