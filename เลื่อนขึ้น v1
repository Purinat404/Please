-- # เปิด/ปิดเมนู
local menuOpen = false
local function toggleMenu()
    menuOpen = not menuOpen
    menu.Visible = true
    if menuOpen then
        menu.Position = UDim2.new(1, 20, 0, 20)
        TweenService:Create(menu, TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
            Position = UDim2.new(1, -440, 0, 20)
        }):Play()
    else
        local t = TweenService:Create(menu, TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
            Position = UDim2.new(1, 20, 0, 20)
        })
        t:Play()
        t.Completed:Connect(function()
            if not menuOpen then menu.Visible = false end
        end)
    end
end

toggleBtn.MouseButton1Click:Connect(toggleMenu)
closeBtn.MouseButton1Click:Connect(toggleMenu)

