local Lighting = game:GetService("Lighting")
local Workspace = game:GetService("Workspace")
local StarterGui = game:GetService("StarterGui")

-- # ตั้งค่าทั้งหมด
local config = {
    -- # ส่วนลบของไม่จำเป็น
    removeTextures = true,      -- ลบ texture ทั้งหมด
    removeDecals = true,        -- ลบ decal/รูปแปะทั้งหมด
    removeParticles = true,     -- ลบ particle effect
    removeFireSmoke = true,     -- ลบไฟ/ควัน/sparkles
    removeShadows = true,       -- ปิดเงา
    removeFog = true,           -- ปิดหมอก
    removeBloom = true,         -- ปิด bloom
    removeSunRays = true,       -- ปิดแสงอาทิตย์
    removePostEffects = true,   -- ปิด post-processing ทั้งหมด

    -- # ส่วนปรับภาพ
    flatLighting = true,        -- แสงแบนเหมือนดินน้ำมัน
    lowestQuality = true,       -- ลดคุณภาพต่ำสุด
    boostFPS = true,            -- เพิ่ม FPS

    -- # ส่วนการทำงาน
    autoRerun = true,           -- วนซ้ำอัตโนมัติ
    rerunInterval = 10,         -- วนทุกกี่วินาที
    rerunJitter = 3,            -- สุ่มเวลาเพิ่ม/ลด
    startDelay = 3,             -- หน่วงก่อนเริ่ม
}

-- # ฟังก์ชันปรับ Lighting
local function optimizeLighting()
    if config.removeShadows then
        Lighting.GlobalShadows = false
    end
    if config.removeFog then
        Lighting.FogEnd = 100000
        Lighting.FogStart = 100000
    end
    for _, v in pairs(Lighting:GetChildren()) do
        if config.removePostEffects and v:IsA("PostEffect") then
            v.Enabled = false
        end
        if config.removeBloom and v:IsA("BloomEffect") then
            v.Enabled = false
        elseif config.removeSunRays and v:IsA("SunRaysEffect") then
            v.Enabled = false
        end
    end
    if config.flatLighting then
        Lighting.Ambient = Color3.fromRGB(180, 180, 180)
        Lighting.OutdoorAmbient = Color3.fromRGB(180, 180, 180)
        Lighting.Brightness = 2
        Lighting.EnvironmentDiffuseScale = 0
        Lighting.EnvironmentSpecularScale = 0
        Lighting.ClockTime = 14
        Lighting.GeographicLatitude = 0
    end
end

-- # ฟังก์ชันลบ texture/decal/effect
local function optimizeWorkspace()
    for _, obj in pairs(Workspace:GetDescendants()) do
        if obj and obj.Parent then
            if config.removeTextures and obj:IsA("Texture") then
                obj:Destroy()
            elseif config.removeDecals and obj:IsA("Decal") then
                obj:Destroy()
            elseif config.removeParticles and obj:IsA("ParticleEmitter") then
                obj:Destroy()
            elseif config.removeFireSmoke and obj:IsA("Fire") then
                obj:Destroy()
            elseif config.removeFireSmoke and obj:IsA("Smoke") then
                obj:Destroy()
            elseif config.removeFireSmoke and obj:IsA("Sparkles") then
                obj:Destroy()
            elseif config.removeParticles and obj:IsA("Beam") then
                obj:Destroy()
            elseif config.removeParticles and obj:IsA("Trail") then
                obj:Destroy()
            elseif config.removeShadows and obj:IsA("PointLight") then
                obj.Shadows = false
            elseif config.removeShadows and obj:IsA("SpotLight") then
                obj.Shadows = false
            end
        end
    end

    local terrain = Workspace:FindFirstChildOfClass("Terrain")
    if terrain and config.removeDecals then
        for _, d in pairs(terrain:GetChildren()) do
            if d and d.Parent and (d:IsA("Decal") or d:IsA("Texture")) then
                d:Destroy()
            end
        end
    end
end

-- # ฟังก์ชันลดคุณภาพ + FPS
local function boostFPS()
    if config.lowestQuality then
        settings().Rendering.QualityLevel = Enum.QualityLevel.Level01
        settings().Rendering.MeshPartDetailLevel = Enum.MeshPartDetailLevel.Level01
    end
    if config.boostFPS then
        settings().Physics.ThrottleAdjustTime = 0
    end
end

-- # ฟังก์ชันรวม กันแครช
local function runAll()
    pcall(optimizeLighting)
    pcall(optimizeWorkspace)
    pcall(boostFPS)
end

-- # ฟังก์ชันหลัก
local function main()
    -- # กันรันซ้ำ
    if getgenv and getgenv().SaikutoRunning then
        return
    end
    if getgenv then
        getgenv().SaikutoRunning = true
    end

    -- # หน่วงก่อนเริ่ม
    if config.startDelay > 0 then
        task.wait(config.startDelay)
    end

    -- # เริ่มทำงาน
    runAll()

    pcall(function()
        StarterGui:SetCore("SendNotification", {
            Title = "Saikuto",
            Text = "โลกกลายเป็นดินน้ำมันแล้ว!",
            Duration = 5,
        })
    end)

    -- # auto re-run
    if config.autoRerun then
        task.spawn(function()
            while task.wait(config.rerunInterval + math.random(0, config.rerunJitter)) do
                if getgenv and not getgenv().SaikutoRunning then
                    break
                end
                pcall(runAll)
            end
        end)
    end
end

-- # เรียกฟังก์ชันหลัก
main()
