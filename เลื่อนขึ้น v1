pfCorner.Parent = progressFill

-- # สถานะ
local statusLabel = Instance.new("TextLabel")
statusLabel.Size = UDim2.new(1, -20, 0, 16)
statusLabel.Position = UDim2.new(0, 10, 1, -56)
statusLabel.BackgroundTransparency = 1
statusLabel.Text = "กำลังเริ่มต้น..."
statusLabel.TextColor3 = Color3.fromRGB(220, 220, 220)
statusLabel.TextSize = 12
statusLabel.Font = Enum.Font.Gotham
statusLabel.TextXAlignment = Enum.TextXAlignment.Left
statusLabel.Parent = mainFrame

-- # ===== ฟังก์ชัน log =====
local logCount = 0
local function addLog(text, color)
    logCount = logCount + 1
    local log = Instance.new("TextLabel")
    log.Size = UDim2.new(1, 0, 0, 16)
    log.BackgroundTransparency = 1
    log.Text = "  " .. text
    log.TextColor3 = color or Color3.fromRGB(180, 180, 180)
    log.TextSize = 12
    log.Font = Enum.Font.Code
    log.TextXAlignment = Enum.TextXAlignment.Left
    log.LayoutOrder = logCount
    log.Parent = logFrame
end

local function setProgress(p)
    progressFill:TweenSize(
        UDim2.new(p / 100, 0, 1, 0),
        Enum.EasingDirection.Out,
        Enum.EasingStyle.Quad,
        0.35,
        true
    )
end

local function setStatus(t)
    statusLabel.Text = t
end

-- # ===== Rainbow Animation (ปรับพอดี) =====
local hue = 0
local rainbowConn = RunService.RenderStepped:Connect(function(dt)
    hue = (hue + dt * 0.12) % 1   -- ปรับความเร็วตรงนี้

    local c1 = Color3.fromHSV(hue, 0.85, 1)
    local c2 = Color3.fromHSV((hue + 0.33) % 1, 0.85, 1)
    local c3 = Color3.fromHSV((hue + 0.66) % 1, 0.85, 1)

    title.TextColor3 = c1
    stroke.Color = c2
    divider.BackgroundColor3 = c3
    progressFill.BackgroundColor3 = c1
    logFrame.ScrollBarImageColor3 = c2
    statusLabel.TextColor3 = Color3.fromRGB(
        200 + math.sin(hue * math.pi * 2) * 50,
        200 + math.sin((hue + 0.33) * math.pi * 2) * 50,
        200 + math.sin((hue + 0.66) * math.pi * 2) * 50
    )
end)

-- # ===== ปิด UI =====
local function closeUI(delayTime)
    task.wait(delayTime or 3)
    setStatus("เสร็จสิ้น กำลังปิด...")
    task.wait(1)

    if rainbowConn then rainbowConn:Disconnect() end

    mainFrame:TweenPosition(
        UDim2.new(0.5, -170, 1.5, 0),
        Enum.EasingDirection.In,
        Enum.EasingStyle.Quad,
        0.5,
        true
    )
    task.wait(0.6)
    screenGui:Destroy()
end

-- # ปุ่ม ESC
UserInputService.InputBegan:Connect(function(input, processed)
    if processed then return end
    if input.KeyCode == Enum.KeyCode.Escape then
        if rainbowConn then rainbowConn:Disconnect() end
        screenGui:Destroy()
    end
end)

-- # ===== Boot sequence (ปรับจังหวะพอดี) =====
addLog("[BOOT] เริ่มระบบ Saikuto...", Color3.fromRGB(255, 100, 200))
