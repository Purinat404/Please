-- # ===== ตัว M สีเงินขาว ขอบฟ้า =====
local function makeLeg(size, pos, rot)
    local leg = Instance.new("Frame")
    leg.Size = size
    leg.Position = pos
    leg.BackgroundColor3 = Color3.fromRGB(230, 235, 245)   -- เงินขาว
    leg.BorderSizePixel = 0
    leg.Rotation = rot
    leg.Parent = ring

    local c = Instance.new("UICorner")
    c.CornerRadius = UDim.new(0, 4)
    c.Parent = leg

    -- # ขอบฟ้าเรืองแสง
    local s = Instance.new("UIStroke")
    s.Thickness = 1.5
    s.Color = Color3.fromRGB(0, 150, 255)
    s.Transparency = 0.3
    s.Parent = leg

    return leg
end

