-- # ===== อนิเมชันเรืองแสง (Pulse เบา ๆ) =====
local glowHue = 0
local rainbowConn = RunService.RenderStepped:Connect(function(dt)
    glowHue = (glowHue + dt * 0.4) % 1

    -- # เรืองแสงฟ้าแบบหายใจ
    local pulse = 0.5 + math.sin(glowHue * math.pi * 2) * 0.5   -- 0 ถึง 1
    local alpha = 0.1 + pulse * 0.4                              -- 0.1 ถึง 0.5

    mainStroke.Transparency = 1 - (0.7 + pulse * 0.3)
    ringStroke.Transparency = 1 - (0.8 + pulse * 0.2)
    titleStroke.Transparency = 0.3 + pulse * 0.3

    -- # สีฟ้าเรืองแสงเปลี่ยนความสว่างเบา ๆ
    local brightness = 0.7 + pulse * 0.3
    mainStroke.Color = Color3.fromRGB(0, 150 * brightness, 255 * brightness)
    ringStroke.Color = Color3.fromRGB(0, 100 * brightness, 220 * brightness)
end)

-- # ปิดด้วย ESC
UserInputService.InputBegan:Connect(function(input, processed)
    if processed then return end
    if input.KeyCode == Enum.KeyCode.Escape then
        if rainbowConn then rainbowConn:Disconnect() end
        screenGui:Destroy()
    end
end)
