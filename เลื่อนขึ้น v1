-- # ลากปุ่มลอย
local draggingBtn = false
local dragStart, startPos
toggleBtn.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        draggingBtn = true
        dragStart = input.Position
        startPos = toggleBtn.Position
    end
end)
UserInputService.InputChanged:Connect(function(input)
    if draggingBtn and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
        local delta = input.Position - dragStart
        toggleBtn.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
    end
end)
UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        draggingBtn = false
    end
end)
    -- # ===== ส่วนที่ 3: ESP + Player + Loop =====
    local espCache = {}

    local function clearESP(plr)
        if espCache[plr] then
            espCache[plr]:Destroy()
            espCache[plr] = nil
            espCache[plr .. "_name"] = nil
            espCache[plr .. "_dist"] = nil
            espCache[plr .. "_health"] = nil
            espCache[plr .. "_healthBg"] = nil
        end
    end

    local function createESP(plr)
        if plr == LocalPlayer then return end
        clearESP(plr)

        local billboard = Instance.new("BillboardGui")
        billboard.Name = "MCoreESP"
        billboard.Size = UDim2.new(0, 200, 0, 60)
        billboard.StudsOffset = Vector3.new(0, 3, 0)
        billboard.AlwaysOnTop = true
        billboard.Parent = screenGui

        local nameLabel = Instance.new("TextLabel")
        nameLabel.Size = UDim2.new(1, 0, 0, 20)
        nameLabel.BackgroundTransparency = 1
        nameLabel.Text = plr.Name
        nameLabel.TextColor3 = Color3.fromRGB(0, 200, 255)
        nameLabel.TextStrokeTransparency = 0
        nameLabel.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
        nameLabel.TextSize = 14
        nameLabel.Font = Enum.Font.GothamBold
        nameLabel.Parent = billboard

        local distLabel = Instance.new("TextLabel")
        distLabel.Size = UDim2.new(1, 0, 0, 14)
        distLabel.Position = UDim2.new(0, 0, 0, 20)
        distLabel.BackgroundTransparency = 1
        distLabel.Text = ""
        distLabel.TextColor3 = Color3.fromRGB(200, 200, 200)
        distLabel.TextStrokeTransparency = 0
        distLabel.TextSize = 11
        distLabel.Font = Enum.Font.Gotham
        distLabel.Parent = billboard

        local healthBg = Instance.new("Frame")
        healthBg.Size = UDim2.new(0, 100, 0, 6)
        healthBg.Position = UDim2.new(0.5, -50, 0, 36)
        healthBg.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
        healthBg.BorderSizePixel = 0
        healthBg.Parent = billboard

        local bgCorner = Instance.new("UICorner")
        bgCorner.CornerRadius = UDim.new(1, 0)
        bgCorner.Parent = healthBg

        local healthFill = Instance.new("Frame")
        healthFill.Size = UDim2.new(1, 0, 1, 0)
        healthFill.BackgroundColor3 = Color3.fromRGB(0, 255, 100)
        healthFill.BorderSizePixel = 0
        healthFill.Parent = healthBg

        local hfCorner = Instance.new("UICorner")
        hfCorner.CornerRadius = UDim.new(1, 0)
        hfCorner.Parent = healthFill

        espCache[plr] = billboard
        espCache[plr .. "_name"] = nameLabel
        espCache[plr .. "_dist"] = distLabel
        espCache[plr .. "_health"] = healthFill
        espCache[plr .. "_healthBg"] = healthBg
    end

    local function updateESP()
        if not config.espEnabled then
            for plr, v in pairs(espCache) do
                if typeof(v) == "Instance" then clearESP(plr) end
            end
            return
        end

        for _, plr in pairs(Players:GetPlayers()) do
            if plr == LocalPlayer then continue end
            local char = plr.Character
            local hrp = char and char:FindFirstChild("HumanoidRootPart")
            local hum = char and char:FindFirstChildOfClass("Humanoid")

            if hrp and hum and hum.Health > 0 then
                if not espCache[plr] then createESP(plr) end
                local billboard = espCache[plr]
                if billboard and billboard.Parent then
                    billboard.Adornee = hrp
                    local dist = (Camera.CFrame.Position - hrp.Position).Magnitude
                    billboard.Enabled = dist <= config.maxDistance

                    local nl = espCache[plr .. "_name"]
                    if nl then nl.Visible = config.showName end

                    local dl = espCache[plr .. "_dist"]
                    if dl then
                        dl.Visible = config.showDistance
                        dl.Text = math.floor(dist) .. " studs"
                    end

                    local hb = espCache[plr .. "_healthBg"]
                    local hf = espCache[plr .. "_health"]
                    if hb and hf then
                        hb.Visible = config.showHealth
                        local percent = hum.Health / hum.MaxHealth
                        hf.Size = UDim2.new(percent, 0, 1, 0)
                        if percent > 0.6 then
                            hf.BackgroundColor3 = Color3.fromRGB(0, 255, 100)
                        elseif percent > 0.3 then
                            hf.BackgroundColor3 = Color3.fromRGB(255, 200, 0)
                        else
                            hf.BackgroundColor3 = Color3.fromRGB(255, 50, 50)
                        end
                    end
                end
            else
                clearESP(plr)
            end
        end
    end

    -- # Player functions
    local function updatePlayer()
        local char = LocalPlayer.Character
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        if hum then
            if config.speedEnabled then
                hum.WalkSpeed = config.speedValue
            else
                hum.WalkSpeed = 16
            end
            if config.jumpEnabled then
                hum.JumpPower = config.jumpValue
                hum.UseJumpPower = true
            else
                hum.JumpPower = 50
            end
        end
    end

    UserInputService.JumpRequest:Connect(function()
        if config.infiniteJump then
            local char = LocalPlayer.Character
            local hum = char and char:FindFirstChildOfClass("Humanoid")
            if hum then
                hum:ChangeState(Enum.HumanoidStateType.Jumping)
            end
        end
    end)

    -- # Loop หลัก
    RunService.RenderStepped:Connect(function()
        pcall(updateESP)
        pcall(updatePlayer)
    end)

    Players.PlayerRemoving:Connect(function(plr)
        clearESP(plr)
    end)

    -- # ESC ปิดเมนู
    UserInputService.InputBegan:Connect(function(input, processed)
        if processed then return end
        if input.KeyCode == Enum.KeyCode.Escape then
            if menuOpen then toggleMenu() end
        end
    end)
end)
