-- # ภาษาไทยข้อมูล
-- MCore v1.0 + Key System
-- วางส่วนที่ 1 แล้วต่อด้วยส่วนที่ 2 ในไฟล์เดียว

local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local TweenService = game:GetService("TweenService")
local LocalPlayer = Players.LocalPlayer

-- # ===== ตั้งค่า Key =====
local VALID_KEYS = {
    ["MCORE2026"] = true,
    ["SAIKUTO"] = true,
    ["PRO999"] = true,
}

-- # ===== กันรันซ้ำ =====
if getgenv().MCoreRunning then
    local old = LocalPlayer:WaitForChild("PlayerGui"):FindFirstChild("MCoreUI")
    local oldKey = LocalPlayer:WaitForChild("PlayerGui"):FindFirstChild("MCoreKeyUI")
    if old then old:Destroy() end
    if oldKey then oldKey:Destroy() end
    getgenv().MCoreRunning = false
end
getgenv().MCoreRunning = true

-- # ===== ฟังก์ชัน Key UI =====
local function showKeyUI(onSuccess)
    local keyGui = Instance.new("ScreenGui")
    keyGui.Name = "MCoreKeyUI"
    keyGui.ResetOnSpawn = false
    keyGui.Parent = LocalPlayer:WaitForChild("PlayerGui")

    local overlay = Instance.new("Frame")
    overlay.Size = UDim2.new(1, 0, 1, 0)
    overlay.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
    overlay.BackgroundTransparency = 0.4
    overlay.BorderSizePixel = 0
    overlay.Parent = keyGui

    local box = Instance.new("Frame")
    box.Size = UDim2.new(0, 320, 0, 220)
    box.Position = UDim2.new(0.5, -160, 0.5, -110)
    box.BackgroundColor3 = Color3.fromRGB(10, 10, 15)
    box.BorderSizePixel = 0
    box.Parent = keyGui

    local boxCorner = Instance.new("UICorner")
    boxCorner.CornerRadius = UDim.new(0, 14)
    boxCorner.Parent = box

    local boxStroke = Instance.new("UIStroke")
    boxStroke.Thickness = 2
    boxStroke.Color = Color3.fromRGB(0, 150, 255)
    boxStroke.Parent = box

    local logoBox = Instance.new("Frame")
    logoBox.Size = UDim2.new(0, 60, 0, 60)
    logoBox.Position = UDim2.new(0.5, -30, 0, 15)
    logoBox.BackgroundColor3 = Color3.fromRGB(15, 15, 22)
    logoBox.BorderSizePixel = 0
    logoBox.Parent = box

    local lbCorner = Instance.new("UICorner")
    lbCorner.CornerRadius = UDim.new(0, 12)
    lbCorner.Parent = logoBox

    local lbStroke = Instance.new("UIStroke")
    lbStroke.Thickness = 2
    lbStroke.Color = Color3.fromRGB(0, 150, 255)
    lbStroke.Parent = logoBox

    local lbText = Instance.new("TextLabel")
    lbText.Size = UDim2.new(1, 0, 1, 0)
    lbText.BackgroundTransparency = 1
    lbText.Text = "M"
    lbText.TextColor3 = Color3.fromRGB(0, 180, 255)
    lbText.TextSize = 32
    lbText.Font = Enum.Font.GothamBlack
    lbText.Parent = logoBox

    local title = Instance.new("TextLabel")
    title.Size = UDim2.new(1, 0, 0, 24)
    title.Position = UDim2.new(0, 0, 0, 82)
    title.BackgroundTransparency = 1
    title.Text = "M-CORE KEY SYSTEM"
    title.TextColor3 = Color3.fromRGB(0, 180, 255)
    title.TextSize = 14
    title.Font = Enum.Font.GothamBold
    title.Parent = box

    local inputBg = Instance.new("Frame")
    inputBg.Size = UDim2.new(1, -40, 0, 40)
    inputBg.Position = UDim2.new(0, 20, 0, 115)
    inputBg.BackgroundColor3 = Color3.fromRGB(18, 18, 26)
    inputBg.BorderSizePixel = 0
    inputBg.Parent = box

    local ibCorner = Instance.new("UICorner")
    ibCorner.CornerRadius = UDim.new(0, 8)
    ibCorner.Parent = inputBg

    local ibStroke = Instance.new("UIStroke")
    ibStroke.Thickness = 1.5
    ibStroke.Color = Color3.fromRGB(0, 100, 200)
    ibStroke.Parent = inputBg

    local input = Instance.new("TextBox")
    input.Size = UDim2.new(1, -20, 1, 0)
    input.Position = UDim2.new(0, 10, 0, 0)
    input.BackgroundTransparency = 1
    input.Text = ""
    input.PlaceholderText = "ใส่ Key ที่นี่..."
    input.PlaceholderColor3 = Color3.fromRGB(120, 120, 140)
    input.TextColor3 = Color3.fromRGB(220, 220, 230)
    input.TextSize = 14
    input.Font = Enum.Font.Gotham
    input.ClearTextOnFocus = false
    input.Parent = inputBg

    local submitBtn = Instance.new("TextButton")
    submitBtn.Size = UDim2.new(1, -40, 0, 40)
    submitBtn.Position = UDim2.new(0, 20, 1, -55)
    submitBtn.BackgroundColor3 = Color3.fromRGB(0, 150, 255)
    submitBtn.BorderSizePixel = 0
    submitBtn.Text = "ยืนยัน"
    submitBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
    submitBtn.TextSize = 14
    submitBtn.Font = Enum.Font.GothamBold
    submitBtn.Parent = box

    local sbCorner = Instance.new("UICorner")
    sbCorner.CornerRadius = UDim.new(0, 8)
    sbCorner.Parent = submitBtn

    local statusLabel = Instance.new("TextLabel")
    statusLabel.Size = UDim2.new(1, -40, 0, 18)
    statusLabel.Position = UDim2.new(0, 20, 0, 158)
    statusLabel.BackgroundTransparency = 1
    statusLabel.Text = ""
    statusLabel.TextColor3 = Color3.fromRGB(255, 100, 100)
    statusLabel.TextSize = 12
    statusLabel.Font = Enum.Font.Gotham
    statusLabel.Parent = box

    local function checkKey()
        local entered = input.Text
        if VALID_KEYS[entered] then
            statusLabel.TextColor3 = Color3.fromRGB(0, 255, 100)
            statusLabel.Text = "✅ Key ถูกต้อง กำลังเข้าสู่ระบบ..."
            task.wait(0.8)
            keyGui:Destroy()
            onSuccess()
        else
            statusLabel.TextColor3 = Color3.fromRGB(255, 100, 100)
            statusLabel.Text = "❌ Key ไม่ถูกต้อง ลองใหม่"
        end
    end

    submitBtn.MouseButton1Click:Connect(checkKey)
    input.FocusLost:Connect(function(enterPressed)
        if enterPressed then checkKey() end
    end)
end

-- # ===== เริ่ม MCore หลังใส่ key ถูก =====
showKeyUI(function()
    -- # โค้ดส่วนที่ 2 ต่อตรงนี้
end)
